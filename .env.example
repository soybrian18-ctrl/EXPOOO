# ---------------------------------------------------------------------------
# Schwab Individual Trader API credentials
# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env
#
# The real ".env" is git-ignored and must NEVER be committed.
# You can also let setup_auth.py prompt you and write these values for you.
# ---------------------------------------------------------------------------

# App Key (a.k.a. "API Key") from https://developer.schwab.com  ->  your app
SCHWAB_API_KEY=

# App Secret for the same app
SCHWAB_APP_SECRET=

# Callback URL configured on your Schwab app. Must match EXACTLY (scheme,
# host, port, trailing slash). Schwab requires https; loopback is allowed.
SCHWAB_CALLBACK_URL=https://127.0.0.1

# Where schwab-py stores the OAuth token (access + refresh tokens).
# Keep this OUT of version control. This default is git-ignored.
SCHWAB_TOKEN_PATH=./schwab_token.json

# Optional: which linked account to report on when several are present.
# Zero-based index into the account list. Defaults to 0 (first account).
SCHWAB_ACCOUNT_INDEX=0
