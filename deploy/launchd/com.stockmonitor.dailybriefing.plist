<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily Morning Briefing. Runs weekdays (Mon-Fri) at 09:00 local.
  Deploy: substitute {{PROJECT_ROOT}}, copy to ~/Library/LaunchAgents/, launchctl load.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stockmonitor.dailybriefing</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{PROJECT_ROOT}}/loops/run.sh</string>
    <string>loops/daily_briefing.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>{{PROJECT_ROOT}}</string>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>{{PROJECT_ROOT}}/logs/launchd_dailybriefing.out</string>
  <key>StandardErrorPath</key>
  <string>{{PROJECT_ROOT}}/logs/launchd_dailybriefing.err</string>
</dict>
</plist>
